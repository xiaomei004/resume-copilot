# ===== 必填：模型接入（任何 OpenAI 兼容服务都可以）=====
# DeepSeek: https://api.deepseek.com/v1        模型 deepseek-chat
# OpenAI:   https://api.openai.com/v1          模型 gpt-4o-mini
# 通义:     https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# ===== 可选：图片版 JD 需要能看图的模型 =====
# 例如 gpt-4o-mini / deepseek-vl2 / qwen-vl-max；留空则跳过图片、提示改填文字
RESUME_VISION_MODEL=

# ===== 可选：联网检索（不填则整条检索链路自动降级）=====
# 目前内置 Tavily：https://tavily.com
TAVILY_API_KEY=

# ===== 可选：LibreOffice 路径（生成 PDF 用；不填则自动找 PATH 里的 soffice）=====
RESUME_SOFFICE=

# ===== 可选：输出目录 =====
RESUME_OUT_DIR=./out
